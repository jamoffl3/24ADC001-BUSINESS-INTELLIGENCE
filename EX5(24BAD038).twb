      <aliases enabled='yes' />
      <column caption='Total Sales' datatype='real' name='[Calculation_0628673462505472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_0628673463787522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales Clean' datatype='real' name='[Calculation_0628673464430595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Sales],0)' />
      </column>
      <column caption='Profit Clean' datatype='real' name='[Calculation_0628673464512516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Profit],0)' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_1019824639893504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(Profit / Sales) * 100' />
      </column>
      <column caption='Sales Growth %' datatype='real' name='[Calculation_1019824640053249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([Sales]), -1)&#13;&#10;* 100'>
          <table-calc ordering-type='Rows' />
